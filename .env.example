# ac2api 配置样例：复制成 .env 后按需修改。
# 所有项都有默认值，最小可用配置是「什么都不填」。

# ---------------------------------------------------------------------------
# 对话链路（已打通，见 README「对话链路」）
# ---------------------------------------------------------------------------
# 对话端点：https://autoglm-acceleration-api.zhipuai.cn/autoclaw-proxy/proxy/autoclaw
#   * 鉴权头是 X-Authorization（不是 Authorization），ac2api 会自动换；
#   * 上游对 system prompt 做前缀校验，必须以
#       You are AutoClaw. Answer the user directly and concisely.
#     开头，否则一律 406（空 body）。ac2api 的 ensure_system_prompt() 会自动补齐，
#     第三方客户端无需改造。
#
# direct = 直连上游（默认，推荐；关掉 AutoClaw 客户端也照常工作）
# client = 借本机 AutoClaw 客户端代发（兜底；需要客户端开着）
# auto   = 连官方网关且本机有客户端时才代发，否则直连
AC2API_CHAT_MODE=direct

# 客户端签名凭证（形如 "id.secret"）。**现在不需要**：406 的真因是 system 前缀，
# 不是签名。此字段仅为兼容旧配置保留。
AC2API_SIGN_CREDENTIAL=

# 本机客户端本地取 token 服务的地址（只有 AutoClaw 家族进程能访问；仅 client 模式用）
AC2API_CLIENT_TOKEN_ENDPOINT=http://127.0.0.1:18432/get_token
# 客户端可执行文件路径（留空自动找 D:\autoclaw 或 Program Files 下的 AutoClaw2.exe）
AC2API_CLIENT_EXE=

# 本地额度记账口径：多少 token 折 1 积分。
# 上游 usage 里没有积分字段，实测约 100 token 扣 1 积分、每次调用至少 1 积分。
# 只影响每个 API Key 的 credit_limit 记账，不影响上游真实扣费。
AC2API_TOKENS_PER_CREDIT=100

# ---------------------------------------------------------------------------
# 上游地址
# ---------------------------------------------------------------------------
# 受管模型网关（对话、模型目录）
AC2API_UPSTREAM_BASE=https://autoglm-acceleration-api.zhipuai.cn
# 身份域（钱包、积分、账号）
AC2API_ACCOUNT_BASE=https://autoglm-api.zhipuai.cn
# 是否扫描本机 AutoClaw 客户端下发的托管配置来发现 base_url（1=扫）
AC2API_DISCOVER=1
# 是否在请求里带 X-Request-Model（官方客户端会带；关掉=0 仅用于排查）
AC2API_SEND_MODEL_HEADER=1

# ---------------------------------------------------------------------------
# token 来源（优先级：手工 token > 外部服务 > 本机客户端凭据）
# ---------------------------------------------------------------------------
# 手工填 accessToken（形如 "Bearer eyJ..." 或裸 JWT 都认）
AC2API_STATIC_TOKEN=
# 外部 token 服务：GET 该地址，返回 {"access_token": "..."} 或裸 token
AC2API_TOKEN_URL=

# ---------------------------------------------------------------------------
# 账号与模型
# ---------------------------------------------------------------------------
# 请求没带 model 时补这个（AutoClaw 真实模型 id：zai_auto / zai_auto-fast /
# zaicoding_glm-5.3 / zai_glm-5.3-flash）
AC2API_DEFAULT_MODEL=zai_auto
# 逗号分隔的模型白名单；留空表示不限制
AC2API_MODELS=

# ---------------------------------------------------------------------------
# 服务监听
# ---------------------------------------------------------------------------
AC2API_HOST=127.0.0.1
AC2API_PORT=8000
# 给 /admin 与管理接口加一层口令（留空 = 不加）
AC2API_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# API Key 存储
# ---------------------------------------------------------------------------
# key 会落盘，网关重启后仍然有效。文件里只存 sha256，不存明文。
# 默认 ~/.ac2api/keys.json；改目录用 AC2API_DATA_DIR，或直接指定文件路径。
AC2API_DATA_DIR=
AC2API_KEYS_FILE=

# ---------------------------------------------------------------------------
# 超时（秒）
# ---------------------------------------------------------------------------
AC2API_CONNECT_TIMEOUT=10
AC2API_READ_TIMEOUT=600
AC2API_CREDITS_TIMEOUT=20

# ---------------------------------------------------------------------------
# 出站代理（通常留空 = 直连）
# ---------------------------------------------------------------------------
# 网关默认**不读 Windows 系统代理**（httpx 的 trust_env 已关掉）：
# 系统代理常配了 127.0.0.1:7890 之类的挂机代理，httpx 不认 ProxyOverride 里
# 对 127.0.0.1 / localhost 的豁免，会把「访问本机 token 服务」「访问本机假上游」
# 的请求也塞给代理，换回一个 **空 body 的 502**，看起来像上游故障，极难排查。
# 所以：需要走代理访问上游时，在这里显式填写，不要指望系统代理。
# 例：http://127.0.0.1:7890
AC2API_UPSTREAM_PROXY=

# ---------------------------------------------------------------------------
# 客户端身份头（照抄客户端 main.cjs 里的值，改了会被上游判非法版本）
# ---------------------------------------------------------------------------
AC2API_CLIENT_VERSION=2.2.4
AC2API_PRODUCT=autoclaw-desktop
AC2API_CLIENT_TYPE=pc
AC2API_APP_ID=100003
AC2API_APP_KEY=38d2391985e2369a5fb8227d8e6cd5e5
# 留空则不下发 X-Channel
AC2API_CHANNEL=
AC2API_LANG=zh-CN
